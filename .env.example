# Variables para docker-compose.yml (producción / Dokploy)
# Copiar a .env y rellenar. NUNCA commitear el .env real.

# --- Requeridas (compose falla si faltan) ---
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
POSTGRES_PASSWORD=password-segura-de-postgres
# Credenciales de MinIO (también usadas por Django como AWS_*)
AWS_ACCESS_KEY_ID=usuario-minio
AWS_SECRET_ACCESS_KEY=password-segura-de-minio
PRINTFUL_API_TOKEN=
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PRINTFUL_WEBHOOK_SECRET=

# --- Opcionales (con default razonable) ---
POSTGRES_USER=mugs
POSTGRES_DB=mugs
AWS_STORAGE_BUCKET_NAME=mugs-media
DRAWINGS_BUCKET_NAME=mugs-drawings
# Endpoint PÚBLICO de MinIO: las URLs firmadas del bucket privado de dibujos
# se generan con este host, así que debe ser alcanzable desde el navegador.
AWS_S3_ENDPOINT_URL=https://minio.app.moonsbow.com
AWS_S3_CUSTOM_DOMAIN=minio.app.moonsbow.com/mugs-media
AWS_S3_VERIFY=False
MINIO_DOMAIN=minio.app.moonsbow.com
SITE_URL=https://mugs.app.moonsbow.com
PRINTFUL_STORE_ID=
PRINTFUL_AUTO_PUSH=False
STRIPE_PUBLISHABLE_KEY=pk_live_...
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=orders@recuerdomomentos.com
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_IMAGE_PROVIDER=gemini
# Admin inicial (se crea en el arranque solo si ambas están definidas)
ADMIN_EMAIL=
ADMIN_PASSWORD=
