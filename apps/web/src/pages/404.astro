---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="Page not found — Recuerdo Momentos">
  <section class="section py-24 text-center md:py-32">
    <div class="mx-auto max-w-xl">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 font-serif text-3xl tracking-tight text-earth md:text-4xl">
        This page wandered off.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-stone">
        The page you're looking for doesn't exist or was moved.
      </p>
      <a href="/" class="btn-primary mt-10 inline-flex">Back to home</a>
    </div>
  </section>
</Layout>
