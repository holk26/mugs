---
import Layout from '../layouts/Layout.astro';
import CartDrawer from '../components/CartDrawer';
---

<Layout title="Cart — Recuerdo Momentos">
  <section class="section py-12 md:py-20">
    <h1 class="font-serif text-4xl tracking-tight text-earth md:text-5xl">Your cart</h1>
    <div class="mt-8 max-w-2xl rounded-3xl border border-earth/5 bg-white p-6 shadow-sm md:p-8">
      <CartDrawer isOpen={true} onClose={() => {}} inline client:load />
    </div>
  </section>
</Layout>
